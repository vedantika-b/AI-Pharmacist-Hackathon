# ==================== Application Settings ====================
APP_NAME=AI Pharmacist API
APP_VERSION=1.0.0
DEBUG=True

# ==================== Supabase Configuration ====================
# Get these from your Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Direct PostgreSQL connection (optional, for advanced queries)
# Format: postgresql://postgres:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ==================== Groq LLM Configuration ====================
# Get API key from: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TEMPERATURE=0.1
GROQ_MAX_TOKENS=1024

# ==================== Machine Learning Configuration ====================
ML_MODEL_PATH=models/ml/refill_predictor.joblib
ML_SCALER_PATH=models/ml/scaler.joblib

# ==================== Business Rules ====================
# Minimum days between prescription refills
MIN_REFILL_DAYS=21

# Maximum dosage multiplier (vs prescribed amount)
MAX_DAILY_DOSAGE_MULTIPLIER=2.0

# ==================== API Configuration ====================
API_V1_PREFIX=/api/v1

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# ==================== Security (Future) ====================
# JWT_SECRET_KEY=your-secret-key-for-jwt
# JWT_ALGORITHM=HS256
# JWT_EXPIRATION_MINUTES=30
