# ==================== LLM Service (Groq) ====================
GROQ_API_KEY=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
GROQ_MODEL=llama-3.1-8b-instant
