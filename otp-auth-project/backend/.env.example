# ==========================================
# OTP Authentication Backend - Environment Variables
# ==========================================
# Copy this file to .env and fill in your values

# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=5000
NODE_ENV=development

# ==========================================
# MONGODB CONNECTION
# ==========================================
# Local MongoDB: mongodb://localhost:27017/otp_auth_db
# MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/otp_auth_db
MONGO_URI=mongodb://localhost:27017/otp_auth_db

# ==========================================
# JWT CONFIGURATION
# ==========================================
# Generate a strong secret: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production-123456
JWT_EXPIRES_IN=7d

# ==========================================
# TWILIO SMS CONFIGURATION
# ==========================================
# Get these from https://www.twilio.com/console
# Leave blank to run in DEMO MODE (OTPs logged to console)

TWILIO_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE=+1234567890

# ==========================================
# FRONTEND URL (for CORS)
# ==========================================
FRONTEND_URL=http://localhost:3000
